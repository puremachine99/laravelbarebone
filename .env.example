APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_VERSION=1.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Gmail App Password (Google Account > Security > App Passwords), bukan password login biasa
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
# Untuk MinIO, isi AWS_ENDPOINT dengan URL server MinIO dan set AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DEBUG_PAGE_PASSWORD=debug123

# --- Nakama AI Center ---
AI_CENTER_DRIVER=nakama
NAKAMA_AI_URL=https://nakama-ai.smartid.or.id
NAKAMA_AI_API_KEY=nk-xxxxxxxx
NAKAMA_AI_PROVIDER=gemini
NAKAMA_AI_MODEL=gemini-3.7-flash
NAKAMA_AI_EFFORT=low
NAKAMA_AI_WEB_SEARCH=false
NAKAMA_AI_DOCUMENT_GENERATION=false
NAKAMA_AI_IMAGE_GENERATION=false

AI_DAILY_MESSAGE_LIMIT=50
AI_PER_MINUTE_LIMIT=10
AI_MAX_INPUT_CHARS=8000
AI_HISTORY_WINDOW=20

AI_TIMEOUT_CONNECT=5
AI_TIMEOUT_FIRST_TOKEN=15
AI_TIMEOUT_TOTAL=120

AI_PRICE_INPUT_PER_1M=
AI_PRICE_OUTPUT_PER_1M=
AI_MONTHLY_BUDGET_USD=

# Bearer token the AI service sends to the data API (/api/ai/*). Empty = API closed.
AI_DATA_API_TOKEN=
# Signs the per-user assertion for the data API (never shared with the AI service). Empty = API closed.
AI_DATA_ASSERTION_SECRET=
# Service account email used when a request has no assertion (AI service querying outside a chat). Empty = disabled.
AI_DATA_SERVICE_USER=
AI_DATA_SERVICE_QUERIES_PER_HOUR=600
# "laravel" (Laravel picks the data) or "gateway" (the AI service calls /api/ai/* as tools).
AI_DATA_MODE=laravel
